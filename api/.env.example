DATABASE_URL=postgres://usuario:clave@localhost:5432/invitaciones
WEB_ORIGIN=http://localhost:3000
PORT=8080
DATABASE_URL_TEST=postgres://usuario:clave@localhost:5432/invitaciones_test

# Google (opcional). Sin esto, el boton no se muestra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_ORIGIN=http://localhost:8080

# Envio de mails. Sin esto, el mail se imprime en la consola en vez de enviarse:
# el flujo de alta y de "olvide mi contrasena" se puede probar entero sin cuenta.
RESEND_API_KEY=
MAIL_FROM=Mi barrio <invitaciones@example.com>

# Avisos push (paquetes). Generar el par con: npx web-push generate-vapid-keys
# VAPID_SUBJECT es un mailto: de contacto. Sin claves, el aviso se imprime en
# la consola; en produccion la API no arranca sin las tres.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 'production' hace que la cookie de sesion salga con Secure. Dejar vacio en
# desarrollo: con Secure y sin HTTPS, el navegador descarta la cookie y no se
# puede entrar.
NODE_ENV=

# Donde se guarda el logo que sube el admin.
