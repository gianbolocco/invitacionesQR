# Un solo origen para todo: la app en la raíz y la API bajo /api.
#
# Que compartan origen no es casualidad. El front llama a la API con la ruta
# relativa /api, así que la imagen no lleva ningún dominio adentro y sirve igual
# en cualquier URL. De paso no hay CORS y la cookie de sesión es first-party.
#
# SITIO define cómo se sirve:
#   un dominio  -> Caddy saca y renueva el certificado solo (producción)
#   ":80"       -> HTTP plano, para cuando el TLS lo termina otro (un túnel)
{
	servers {
		# Delante de este Caddy puede haber otro proxy en la red privada (el de
		# Coolify). Sin esto Caddy pisa su X-Forwarded-For con la IP de ese
		# proxy, y la API ve a todos los clientes con la misma IP. A un cliente
		# de internet se le sigue ignorando el header que mande.
		trusted_proxies static private_ranges
	}
}

{$SITIO} {
	# Todo comprimido salvo los avisos en vivo de la garita: comprimir un stream
	# de Server-Sent Events lo retiene en el buffer y los avisos llegan tarde.
	@comprimible not path /api/gate/eventos
	encode @comprimible zstd gzip

	# La CSP no va acá: lleva un nonce por request y la pone web/src/proxy.ts.
	# HSTS sin includeSubDomains ni preload: pazzit.com es la landing y vive aparte.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# La garita lee el QR con la cámara; nada más pide permisos.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
	}

	# Un ambiente de prueba (qa) va detrás de usuario y contraseña: se activa
	# cargando QA_PASS_HASH; vacía, como en producción, no pide nada. Sin pasar
	# por acá el healthcheck, que es del propio contenedor y no tiene credenciales.
	@protegido {
		expression "{$QA_PASS_HASH}" != ""
		not path /api/health
	}
	# El hash por defecto nunca se usa (sin QA_PASS_HASH el matcher no aplica),
	# pero Caddy lo valida al arrancar: es de un valor al azar que no se guardó.
	basic_auth @protegido {
		{$QA_USUARIO:qa} {$QA_PASS_HASH:$2a$14$5Vjj48EVRNcT5qbrlsVNLurS75Z9RdZ8giXLWjTi65P0y0.23JrZe}
	}
	header @protegido X-Robots-Tag "noindex, nofollow"

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
