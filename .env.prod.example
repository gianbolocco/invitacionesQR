# Copiar a .env en el servidor y completar. NO se commitea.

# El dominio que apunta al VPS. Caddy saca el certificado solo para este nombre,
# así que tiene que resolver a la IP del servidor ANTES de levantar el stack.
DOMINIO=invitaciones.losaromos.com.ar

# Contraseña de Postgres. Generar una larga y al azar, por ejemplo:
#   openssl rand -base64 32
DB_PASSWORD=

# Envío de mails (altas y "olvidé mi contraseña"). Sin esto, los mails se
# imprimen en el log del contenedor en vez de enviarse: sirve para probar, pero
# en el barrio nadie recibe su link de alta.
RESEND_API_KEY=
MAIL_FROM=Los Aromos <invitaciones@losaromos.com.ar>

# Login con Google (opcional). Sin esto el botón no se muestra.
# El "Authorized redirect URI" en Google Cloud tiene que ser exactamente:
#   https://$DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El barrio de esta instalación. Se siembra al primer arranque, y el link de
# alta del admin sale por el log del contenedor (o por mail, si hay
# RESEND_API_KEY). Si la base ya tiene un barrio, no se hace nada: cambiar estos
# valores después NO renombra nada, eso se hace desde Administración → Barrio.
BARRIO_NOMBRE=Los Aromos
BARRIO_DIRECCION=Ruta 8 km 62, Pilar
BARRIO_MAPA=https://maps.app.goo.gl/...
ADMIN_EMAIL=admin@losaromos.com.ar
ADMIN_NOMBRE=Nombre del administrador
