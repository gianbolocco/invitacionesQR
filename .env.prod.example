# Copiar a .env en el servidor y completar. NO se commitea.

# El dominio que apunta al VPS. Caddy saca el certificado solo para este nombre,
# así que tiene que resolver a la IP del servidor ANTES de levantar el stack.
DOMINIO=invitaciones.alamoalto.com.ar

# Contraseña de Postgres. Generar una larga y al azar, por ejemplo:
#   openssl rand -base64 32
DB_PASSWORD=

# Envío de mails (altas y "olvidé mi contraseña"). Sin esto, los mails se
# imprimen en el log del contenedor en vez de enviarse: sirve para probar, pero
# en el barrio nadie recibe su link de alta.
RESEND_API_KEY=
MAIL_FROM=Álamo Alto <invitaciones@alamoalto.com.ar>

# Login con Google (opcional). Sin esto el botón no se muestra.
# El "Authorized redirect URI" en Google Cloud tiene que ser exactamente:
#   https://$DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
