DATABASE_URL=postgres://usuario:clave@localhost:5432/invitaciones
WEB_ORIGIN=http://localhost:3000
PORT=8080
DATABASE_URL_TEST=postgres://usuario:clave@localhost:5432/invitaciones_test

# Google (opcional). Sin esto, el boton no se muestra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_ORIGIN=http://localhost:8080

# Envio de mails. Sin esto, el mail se imprime en la consola en vez de enviarse:
# el flujo de alta y de "olvide mi contrasena" se puede probar entero sin cuenta.
RESEND_API_KEY=
MAIL_FROM=Alamo Alto <invitaciones@example.com>

# 'production' hace que la cookie de sesion salga con Secure. Dejar vacio en
# desarrollo: con Secure y sin HTTPS, el navegador descarta la cookie y no se
# puede entrar.
NODE_ENV=
