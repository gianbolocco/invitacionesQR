        "invitation_kind_ck": {
          "name": "invitation_kind_ck",
          "value": "\"invitation\".\"kind\" in ('visita','frecuente','proveedor','delivery')"
        },
        "invitation_delivery_ck": {
          "name": "invitation_delivery_ck",
          "value": "case when \"invitation\".\"kind\" = 'delivery' then \"invitation\".\"delivery_app\" is not null and \"invitation\".\"expires_at\" is not null else \"invitation\".\"delivery_app\" is null and \"invitation\".\"expires_at\" is null end"
        },
        "invitation_delivery_app_ck": {
          "name": "invitation_delivery_app_ck",
          "value": "\"invitation\".\"delivery_app\" in ('pedidosya','rappi','mercadolibre','otro')"
        },
        "invitation_frequent_as_ck": {
          "name": "invitation_frequent_as_ck",
          "value": "\"invitation\".\"frequent_as\" is null\n    or (\"invitation\".\"kind\" = 'frecuente' and \"invitation\".\"frequent_as\" in ('visita','proveedor'))"
        },
        "invitation_trade_ck": {
          "name": "invitation_trade_ck",
          "value": "\"invitation\".\"trade_id\" is null or \"invitation\".\"kind\" = 'proveedor'\n    or (\"invitation\".\"kind\" = 'frecuente' and \"invitation\".\"frequent_as\" = 'proveedor')"
        },
        "invitation_window_ck": {
          "name": "invitation_window_ck",
          "value": "\"invitation\".\"valid_to\" >= \"invitation\".\"valid_from\""
        },
        "invitation_capacity_ck": {
          "name": "invitation_capacity_ck",
          "value": "\"invitation\".\"capacity\" >= 1"
        },
        "invitation_note_ck": {
          "name": "invitation_note_ck",
          "value": "char_length(\"invitation\".\"note\") <= 140"
        }
      },
      "isRLSEnabled": false
    },
