# Un solo origen para todo: la app en la raíz y la API bajo /api.
#
# Que compartan origen no es casualidad. El front llama a la API con la ruta
# relativa /api, así que la imagen no lleva ningún dominio adentro y sirve igual
# en cualquier URL. De paso no hay CORS y la cookie de sesión es first-party.
#
# SITIO define cómo se sirve:
#   un dominio  -> Caddy saca y renueva el certificado solo (producción)
#   ":80"       -> HTTP plano, para cuando el TLS lo termina otro (un túnel)
{
	servers {
		# Delante de este Caddy puede haber otro proxy en la red privada (el de
		# Coolify). Sin esto Caddy pisa su X-Forwarded-For con la IP de ese
		# proxy, y la API ve a todos los clientes con la misma IP. A un cliente
		# de internet se le sigue ignorando el header que mande.
		trusted_proxies static private_ranges
	}
}

{$SITIO} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
