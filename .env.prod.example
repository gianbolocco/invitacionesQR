# Copiar a .env en el servidor y completar. NO se commitea.

# El dominio que apunta al VPS. Caddy saca el certificado solo para este nombre,
# así que tiene que resolver a la IP del servidor ANTES de levantar el stack.
DOMINIO=invitaciones.losaromos.com.ar

# Contraseña de Postgres. Generar una larga y al azar, por ejemplo:
#   openssl rand -base64 32
DB_PASSWORD=

# Envío de mails (altas y "olvidé mi contraseña"). Obligatorias: en producción
# la API no arranca sin ellas. El fallback de imprimir los mails en el log es
# solo para desarrollo, porque deja los links de acceso a la vista.
RESEND_API_KEY=
MAIL_FROM=Los Aromos <invitaciones@losaromos.com.ar>

# Login con Google (opcional). Sin esto el botón no se muestra.
# El "Authorized redirect URI" en Google Cloud tiene que ser exactamente:
#   https://$DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# El primer admin. Al primer arranque se crean el barrio y este admin, y su link
# de alta sale por el log del contenedor (o por mail, si hay RESEND_API_KEY).
# Nombre, dirección y mapa del barrio se cargan después en Administración → Barrio.
ADMIN_EMAIL=admin@losaromos.com.ar
ADMIN_NOMBRE=Nombre del administrador
